# Copy to deploy/tinybird.env on the production host and chmod 600.
# Never commit the populated file.

TINYBIRD_AUTH_URL=https://auth.0xstash.dev
TINYBIRD_AUTH_PROJECT=tinybird
TINYBIRD_AUTH_PROJECT_SECRET=

TINYBIRD_MEDIA_URL=https://media.0xstash.dev
TINYBIRD_MEDIA_PROJECT=tinybird
TINYBIRD_MEDIA_OWNER=production
TINYBIRD_MEDIA_VAULT=default
TINYBIRD_MEDIA_KEY=

TINYBIRD_CONTACT_URL=https://contact.0xstash.dev
TINYBIRD_CONTACT_KEY=
# Contact checks this against the TinyBird project's registered origins.
TINYBIRD_CONTACT_ORIGIN=https://gba.0xstash.dev
